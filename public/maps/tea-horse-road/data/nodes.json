{"_comment":"茶马古道驿镇节点（GCJ-02）。properties.wgs84 为原始 WGS84 经纬度。","type":"FeatureCollection","features":[{"type":"Feature","properties":{"id":"diancang-1","name":"普洱","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":1,"of":9,"kind":"origin","note":"滇南茶山门户，清代普洱茶的主要集散地。","wgs84":[100.97,22.78]},"geometry":{"type":"Point","coordinates":[100.97119,22.777]}},{"type":"Feature","properties":{"id":"diancang-2","name":"景东","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":2,"of":9,"kind":"stage","note":"无量山与哀牢山之间的坝子，滇南进入滇西的过渡驿站。","wgs84":[100.84,24.45]},"geometry":{"type":"Point","coordinates":[100.84112,24.44691]}},{"type":"Feature","properties":{"id":"diancang-3","name":"大理","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":3,"of":9,"kind":"stage","note":"苍山洱海之间的商帮枢纽，喜洲、下关的马帮在此换货。","wgs84":[100.23,25.6]},"geometry":{"type":"Point","coordinates":[100.2311,25.59697]}},{"type":"Feature","properties":{"id":"diancang-4","name":"剑川","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":4,"of":9,"kind":"stage","note":"白族木雕之乡，滇西北入藏前的最后一片河谷平坝。","wgs84":[99.91,26.54]},"geometry":{"type":"Point","coordinates":[99.91092,26.53626]}},{"type":"Feature","properties":{"id":"diancang-5","name":"丽江","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":5,"of":9,"kind":"stage","note":"纳西族聚居的商贸重镇，藏区马帮与云南茶商的交易中心。","wgs84":[100.23,26.87]},"geometry":{"type":"Point","coordinates":[100.23113,26.86645]}},{"type":"Feature","properties":{"id":"diancang-6","name":"香格里拉","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":6,"of":9,"kind":"stage","note":"旧称中甸，进入藏区高原的第一级台阶，海拔升至 3,300 米。","wgs84":[99.71,27.83]},"geometry":{"type":"Point","coordinates":[99.71111,27.82651]}},{"type":"Feature","properties":{"id":"diancang-7","name":"德钦","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":7,"of":9,"kind":"stage","note":"梅里雪山脚下的滇藏门户，澜沧江河谷的最后一个大驿站。","wgs84":[98.91,28.48]},"geometry":{"type":"Point","coordinates":[98.91044,28.47633]}},{"type":"Feature","properties":{"id":"diancang-8","name":"盐井","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":8,"of":9,"kind":"stage","note":"澜沧江边的古盐田，晒盐与运茶在此交汇，今属西藏芒康县。","wgs84":[98.6,29.04]},"geometry":{"type":"Point","coordinates":[98.60023,29.03668]}},{"type":"Feature","properties":{"id":"diancang-9","name":"芒康","route":"diancang","route_name":"滇藏道","route_no":"01","color":"#3fae86","seq":9,"of":9,"kind":"junction","note":"滇藏道与川藏道的会合点，自此向西共用一条路。","wgs84":[98.59,29.68]},"geometry":{"type":"Point","coordinates":[98.59023,29.67703]}},{"type":"Feature","properties":{"id":"chuancang-1","name":"雅安","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":1,"of":15,"kind":"origin","note":"川西边茶的中心，茶号在此压制砖茶后启运。","wgs84":[103.0,29.99]},"geometry":{"type":"Point","coordinates":[103.00181,29.9873]}},{"type":"Feature","properties":{"id":"chuancang-2","name":"泸定","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":2,"of":15,"kind":"stage","note":"大渡河铁索桥所在，翻二郎山后的第一处歇脚地。","wgs84":[102.23,29.91]},"geometry":{"type":"Point","coordinates":[102.23157,29.9073]}},{"type":"Feature","properties":{"id":"chuancang-3","name":"康定","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":3,"of":15,"kind":"stage","note":"旧称打箭炉，茶马互市的核心市场，\"锅庄\"于此云集。","wgs84":[101.96,30.05]},"geometry":{"type":"Point","coordinates":[101.96151,30.04717]}},{"type":"Feature","properties":{"id":"chuancang-4","name":"雅江","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":4,"of":15,"kind":"stage","note":"雅砻江河谷中的小城，海拔骤降再骤升的中继站。","wgs84":[101.01,30.03]},"geometry":{"type":"Point","coordinates":[101.01154,30.0273]}},{"type":"Feature","properties":{"id":"chuancang-5","name":"理塘","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":5,"of":15,"kind":"stage","note":"毛垭大草原上的高城，海拔约 4,000 米，康巴地区商贸中心。","wgs84":[100.27,29.99]},"geometry":{"type":"Point","coordinates":[100.27121,29.98727]}},{"type":"Feature","properties":{"id":"chuancang-6","name":"巴塘","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":6,"of":15,"kind":"stage","note":"金沙江畔的川滇藏结合部，入藏前的最后一个四川大站。","wgs84":[99.1,30.0]},"geometry":{"type":"Point","coordinates":[99.10106,29.99743]}},{"type":"Feature","properties":{"id":"chuancang-7","name":"芒康","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":7,"of":15,"kind":"junction","note":"滇藏道在此汇入，两条主线合流后继续西行。","wgs84":[98.59,29.68]},"geometry":{"type":"Point","coordinates":[98.59023,29.67703]}},{"type":"Feature","properties":{"id":"chuancang-8","name":"左贡","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":8,"of":15,"kind":"stage","note":"玉曲河谷的牧业县，往北可通川藏北线重镇昌都。","wgs84":[97.84,29.67]},"geometry":{"type":"Point","coordinates":[97.84029,29.66709]}},{"type":"Feature","properties":{"id":"chuancang-9","name":"邦达","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":9,"of":15,"kind":"stage","note":"川藏南线与北线的交汇处，草原上的分岔口。","wgs84":[97.29,30.28]},"geometry":{"type":"Point","coordinates":[97.29048,30.27726]}},{"type":"Feature","properties":{"id":"chuancang-10","name":"八宿","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":10,"of":15,"kind":"stage","note":"怒江峡谷上缘，著名的怒江七十二拐就在附近。","wgs84":[96.92,30.05]},"geometry":{"type":"Point","coordinates":[96.92013,30.04704]}},{"type":"Feature","properties":{"id":"chuancang-11","name":"然乌","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":11,"of":15,"kind":"stage","note":"然乌湖畔，帕隆藏布江的源头段，藏东南湿润区的开端。","wgs84":[96.76,29.49]},"geometry":{"type":"Point","coordinates":[96.7603,29.48713]}},{"type":"Feature","properties":{"id":"chuancang-12","name":"波密","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":12,"of":15,"kind":"stage","note":"帕隆藏布河谷，冰川与森林交错，海拔降至 2,700 米左右。","wgs84":[95.77,29.86]},"geometry":{"type":"Point","coordinates":[95.7708,29.8572]}},{"type":"Feature","properties":{"id":"chuancang-13","name":"林芝","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":13,"of":15,"kind":"stage","note":"尼洋河与雅鲁藏布江汇流处，藏东南的门户城市。","wgs84":[94.36,29.65]},"geometry":{"type":"Point","coordinates":[94.36116,29.64731]}},{"type":"Feature","properties":{"id":"chuancang-14","name":"工布江达","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":14,"of":15,"kind":"stage","note":"尼洋河上游，翻米拉山前的最后一站。","wgs84":[93.25,29.89]},"geometry":{"type":"Point","coordinates":[93.25124,29.88717]}},{"type":"Feature","properties":{"id":"chuancang-15","name":"拉萨","route":"chuancang","route_name":"川藏道","route_no":"02","color":"#e0924a","seq":15,"of":15,"kind":"terminus","note":"三条主线的共同终点，高原上最大的消费与宗教中心。","wgs84":[91.14,29.65]},"geometry":{"type":"Point","coordinates":[91.14153,29.64727]}},{"type":"Feature","properties":{"id":"qingzang-1","name":"西安","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":1,"of":12,"kind":"origin","note":"旧称长安，唐蕃古道的起点，中原一侧的货物集散地。","wgs84":[108.94,34.34]},"geometry":{"type":"Point","coordinates":[108.94466,34.33844]}},{"type":"Feature","properties":{"id":"qingzang-2","name":"天水","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":2,"of":12,"kind":"stage","note":"渭河上游，陇右入关中的第一处大驿。","wgs84":[105.72,34.58]},"geometry":{"type":"Point","coordinates":[105.72393,34.57868]}},{"type":"Feature","properties":{"id":"qingzang-3","name":"兰州","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":3,"of":12,"kind":"stage","note":"黄河渡口，自此离开黄河流域、折向湟水谷地。","wgs84":[103.82,36.06]},"geometry":{"type":"Point","coordinates":[103.82243,36.0597]}},{"type":"Feature","properties":{"id":"qingzang-4","name":"西宁","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":4,"of":12,"kind":"stage","note":"河湟谷地的中心，中原通往青藏的门户。","wgs84":[101.78,36.62]},"geometry":{"type":"Point","coordinates":[101.78193,36.61992]}},{"type":"Feature","properties":{"id":"qingzang-5","name":"湟源","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":5,"of":12,"kind":"stage","note":"日月山以东，农牧交错带上的茶马互市口岸。","wgs84":[101.26,36.68]},"geometry":{"type":"Point","coordinates":[101.2619,36.67996]}},{"type":"Feature","properties":{"id":"qingzang-6","name":"共和","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":6,"of":12,"kind":"stage","note":"青海湖南岸的恰卜恰，翻青海南山后进入高原面。","wgs84":[100.62,36.28]},"geometry":{"type":"Point","coordinates":[100.62128,36.2796]}},{"type":"Feature","properties":{"id":"qingzang-7","name":"玛多","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":7,"of":12,"kind":"stage","note":"黄河源头第一县，海拔 4,200 米以上，人烟稀少。","wgs84":[98.21,34.92]},"geometry":{"type":"Point","coordinates":[98.21049,34.91892]}},{"type":"Feature","properties":{"id":"qingzang-8","name":"玉树","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":8,"of":12,"kind":"stage","note":"通天河与扎曲交汇处，青海南部最大的商贸集散地。","wgs84":[97.01,33.0]},"geometry":{"type":"Point","coordinates":[97.01044,32.99787]}},{"type":"Feature","properties":{"id":"qingzang-9","name":"唐古拉山口","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":9,"of":12,"kind":"pass","note":"青海与西藏的天然分界，海拔超过 5,000 米，全线最高的一段。","wgs84":[92.35,32.95]},"geometry":{"type":"Point","coordinates":[92.35119,32.94786]}},{"type":"Feature","properties":{"id":"qingzang-10","name":"那曲","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":10,"of":12,"kind":"stage","note":"羌塘草原上的重镇，藏北牧区的畜产品在此集结南下。","wgs84":[92.06,31.48]},"geometry":{"type":"Point","coordinates":[92.06129,31.47778]}},{"type":"Feature","properties":{"id":"qingzang-11","name":"当雄","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":11,"of":12,"kind":"stage","note":"念青唐古拉山南麓，进入拉萨河谷平原前的最后一站。","wgs84":[91.1,30.48]},"geometry":{"type":"Point","coordinates":[91.10159,30.47736]}},{"type":"Feature","properties":{"id":"qingzang-12","name":"拉萨","route":"qingzang","route_name":"青藏道","route_no":"03","color":"#b07ad6","seq":12,"of":12,"kind":"terminus","note":"与川藏道共用的终点，三线在此收束成一点。","wgs84":[91.14,29.65]},"geometry":{"type":"Point","coordinates":[91.14153,29.64727]}}]}